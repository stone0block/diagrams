{
  "name": "diagrams-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site and MCP server for the diagrams plugin (working name, final name TBD)",
  "scripts": {
    "vendor": "node scripts/vendor-mermaid.mjs",
    "dev": "npm run vendor && wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy": "npm run vendor && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.25.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "mermaid": "12.1.0",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
